                "type": "text/javascript",
                "exec": [
                  "const stamp = Date.now()",
                  "pm.collectionVariables.set('authEmail', `postman_${stamp}@example.com`)",
                  "pm.collectionVariables.set('authUsername', `postman_${stamp}`)",
                  "pm.collectionVariables.set('authPassword', 'password123')"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201))",
                  "const body = pm.response.json()",
                  "pm.collectionVariables.set('accessToken', body.data.token)",
                  "pm.collectionVariables.set('userId', body.data.user.id)",
                  "pm.test('role is member', () => pm.expect(body.data.user.role).to.eql('member'))",
                  "pm.test('no password hash leaked', () => pm.expect(body.data.user).to.not.have.property('password_hash'))"
